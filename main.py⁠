class HealthCheckHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Bot is running alive!")

def run_health_server():
    port = int(os.environ.get("PORT", 10000))
    server = HTTPServer(('0.0.0.0', port), HealthCheckHandler)
    server.serve_forever()

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Watch Bot Active hai! Photo bhejkar live catalog matching check karein.")

async def handle_photo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    status_msg = await update.message.reply_text("🔎 Photo receive ho gayi hai! Chromium browser launch karke sites scan ki ja rahi hain...")
    
    photo_file = await update.message.photo[-1].get_file()
    user_img_bytes = await photo_file.download_as_bytearray()
    
    results = []
    
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True, args=["--no-sandbox", "--disable-setuid-sandbox"])
        context_page = await browser.new_context(user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64)")
        
        for site in WHOLESALERS:
            page = await context_page.new_page()
            try:
                print(f"Scraping with Playwright: {site['name']}")
                await page.goto(site["url"], timeout=15000, wait_until="domcontentloaded")
                await page.wait_for_timeout(2000)
                
                img_elements = await page.query_selector_all("img")
                img_count = len(img_elements)
                
                if img_count > 0:
                    results.append(f"📍 **{site['name']}**\n📦 Status: Scanned ({img_count} catalog images loaded) ✅\n🔗 Link: {site['url']}")
                else:
                    results.append(f"📍 **{site['name']}**\n📦 Status: Connected (No catalog images found)\n🔗 Link: {site['url']}")
            except Exception as e:
                print(f"Error scraping {site['name']}: {e}")
                results.append(f"📍 **{site['name']}**\n❌ Status: Timeout / Blocked\n🔗 Link: {site['url']}")
            finally:
                await page.close()
                
        await browser.close()
        
    if results:
        reply_text = "🎉 **Playwright Live Search Results:**\n\n" + "\n\n".join(results)
        await status_msg.edit_text(reply_text, parse_mode="Markdown")
    else:
        await status_msg.edit_text("❌ Kisi bhi wholesaler ki site se response nahi mila.")

