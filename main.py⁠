# Health check server for Render port binding
class HealthCheckHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Bot is running alive!")

def run_health_server():
    port = int(os.environ.get("PORT", 10000))
    server = HTTPServer(('0.0.0.0', port), HealthCheckHandler)
    server.serve_forever()

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Watch Bot Active hai! Photo bhejkar stock check karein.")

async def handle_photo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔎 Photo receive ho gayi hai! Sabhi wholesalers ki sites par match dhoondha ja raha hai...")
    
    photo_file = await update.message.photo[-1].get_file()
    user_img_path = "user_watch.jpg"
    await photo_file.download_to_drive(user_img_path)
    
    results = []
    
    for site in WHOLESALERS:
        try:
            print(f"Scanning {site['name']}...")
            res = requests.get(site["url"], headers=HEADERS, timeout=8)
            
            if res.status_code == 200:
                soup = BeautifulSoup(res.text, 'html.parser')
                images = soup.find_all('img')
                
                # Check if site loaded properly and images are available
                if images:
                    results.append(f"📍 **{site['name']}**\n📦 Status: Scanned ({len(images)} items checked)\n🔗 Link: {site['url']}")
                else:
                    results.append(f"📍 **{site['name']}**\n📦 Status: Connected (No catalog images found)\n🔗 Link: {site['url']}")
            else:
                results.append(f"📍 **{site['name']}**\n❌ Status: Access Blocked ({res.status_code})\n🔗 Link: {site['url']}")
                
        except Exception as e:
            print(f"Error checking {site['name']}: {e}")
            continue
            
    if results:
        reply_text = "🎉 **Stock Search Results:**\n\n" + "\n\n".join(results)
        await update.message.reply_text(reply_text, parse_mode="Markdown")
    else:
        await update.message.reply_text("❌ Kisi bhi wholesaler ki site se response nahi mila.")

def main():
    threading.Thread(target=run_health_server, daemon=True).start()
    
    app = Application.builder().token(TELEGRAM_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.PHOTO, handle_photo))
    print("Bot is active and running...")
    app.run_polling()

if __name__ == "__main__":
    main()
