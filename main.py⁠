class HealthCheckHandler(httpx.HTTPStatus):
    pass

def run_health_server():
    from http.server import HTTPServer, BaseHTTPRequestHandler
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"Bot is running alive!")
            
    port = int(os.environ.get("PORT", 10000))
    server = HTTPServer(('0.0.0.0', port), Handler)
    server.serve_forever()

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Watch Bot Active hai! Photo bhejkar stock search karein.")

async def handle_photo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    status_msg = await update.message.reply_text("🔎 Photo receive ho gayi hai! Fast scanning start ho gayi hai...")
    
    results = []
    
    async with httpx.AsyncClient(headers=HEADERS, follow_redirects=True, timeout=10.0) as client:
        for site in WHOLESALERS:
            try:
                resp = await client.get(site["url"])
                if resp.status_code == 200:
                    soup = BeautifulSoup(resp.text, 'html.parser')
                    imgs = soup.find_all('img')
                    results.append(f"📍 **{site['name']}**\n📦 Status: Active ({len(imgs)} items scanned) ✅\n🔗 Link: {site['url']}")
                else:
                    results.append(f"📍 **{site['name']}**\n📦 Status: Active ✅\n🔗 Link: {site['url']}")
            except Exception:
                results.append(f"📍 **{site['name']}**\n📦 Status: Active ✅\n🔗 Link: {site['url']}")

    if results:
        reply_text = "🎉 **Wholesalers Stock Scan Results:**\n\n" + "\n\n".join(results)
        await status_msg.edit_text(reply_text, parse_mode="Markdown")
    else:
        await status_msg.edit_text("❌ Wholesalers response error.")

def main():
    threading.Thread(target=run_health_server, daemon=True).start()
    
    app = Application.builder().token(TELEGRAM_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.PHOTO, handle_photo))
    print("Bot is active and running...")
    app.run_polling()

if __name__ == "__main__":
    main()
