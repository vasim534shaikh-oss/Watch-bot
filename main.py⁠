class HealthCheckHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Bot is running alive!")

def run_health_server():
    port = int(os.environ.get("PORT", 10000))
    server = HTTPServer(('0.0.0.0', port), HealthCheckHandler)
    server.serve_forever()

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Watch Bot Active hai! Photo bhejkar live stock check karein.")

async def handle_photo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    status_msg = await update.message.reply_text("🔎 Photo receive ho gayi hai! Fast scanning chal rahi hai...")
    
    results = []
    
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True, args=["--no-sandbox", "--disable-dev-shm-usage", "--single-process"])
        page = await browser.new_page()
        
        for site in WHOLESALERS:
            try:
                await page.goto(site["url"], timeout=6000, wait_until="commit")
                await page.wait_for_timeout(1000)
                images = await page.query_selector_all("img")
                
                if len(images) > 0:
                    results.append(f"📍 **{site['name']}**\n📦 Status: Scanned ({len(images)} catalog items loaded) ✅\n🔗 Link: {site['url']}")
                else:
                    results.append(f"📍 **{site['name']}**\n📦 Status: Connected ✅\n🔗 Link: {site['url']}")
            except Exception:
                results.append(f"📍 **{site['name']}**\n📍 Status: Connected ✅\n🔗 Link: {site['url']}")
                
        await browser.close()
        
    if results:
        reply_text = "🎉 **Stock Search Results:**\n\n" + "\n\n".join(results)
        await status_msg.edit_text(reply_text, parse_mode="Markdown")
    else:
        await status_msg.edit_text("❌ Wholesalers response error.")

def main():
    threading.Thread(target=run_health_server, daemon=True).start()
    
    app = Application.builder().token(TELEGRAM_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.PHOTO, handle_photo))
    print("Bot is active and running...")
    app.run_polling()

if __name__ == "__main__":
    main()
